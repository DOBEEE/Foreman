# ─────────────────────────────────────────────────────────────
# .env 只放「凭据」与「本机相关路径」；行为参数一律在 server/config/app.json 里改
#   公共配置：server/config/app.json（端口/模型/轮次/渠道开关/定时复盘）
#   岗位配置：server/config/agents/<id>.json（职责/提示词/工具/工作目录/复盘规则）
#   MCP：server/config/mcp.servers.json（内置）+ ~/.foreman/mcp.servers.json（用户自装，合并）
#   boss 人格：server/config/boss.json
#   用户目录（仓库外 ~/.foreman，不进 git）：员工 / 自装 plugin / 自装 MCP / 经验库 / 会话与任务
#   出厂预置（进 git）：presets/ —— 首次启动播种进用户目录，之后可改可删不复活
# 下面的环境变量都是可选覆盖（env > config/app.json > 内置默认）
# ─────────────────────────────────────────────────────────────

# Anthropic 凭据：直连填 API_KEY；走代理填 BASE_URL + AUTH_TOKEN
ANTHROPIC_API_KEY=
# ANTHROPIC_BASE_URL=https://your-proxy
# ANTHROPIC_AUTH_TOKEN=

# 联网搜索：内置 WebSearch / WebFetch 在代理网关下不可用（网关不支持 web_search；
# WebFetch 的域名校验要访问被拦的 claude.ai），已通过 app.json 的 disabledTools 默认禁用。
# 替代方案已接好 —— 默认用免 key 的 "websearch" MCP（open-websearch，bing/baidu 等多引擎
# search + fetchWebContent 抓正文），无需任何凭据。下面两个是可选升级（结果更干净）：
# 【推荐改用 Dashboard → 设置 → 渠道与密钥 配置，落 ~/.foreman/credentials.json（0600），下个任务即生效】
# 填了 key 才会挂载；给员工授权 = 在其配置里把 mcpServers 换成 ["tavily"]
# TAVILY_API_KEY=            # https://app.tavily.com  免费 1000 次/月，搜索 + 正文提取
# EXA_API_KEY=               # https://dashboard.exa.ai 语义检索，注册送 $20、每月补 $10

# 钉钉机器人（Stream 模式，AppKey / AppSecret）
# 【推荐改用 Dashboard → 设置 → 渠道与密钥 配置：AppKey/robotCode 存 settings、AppSecret 存
#   credentials.json（0600）；改完点「保存并重连」即生效，无需重启进程】
# 钉钉后台「消息接收模式」必须选 Stream 模式（本服务不提供 HTTP 回调）。
# DINGTALK_CLIENT_ID=
# DINGTALK_CLIENT_SECRET=
# 主动推送用的 robotCode，默认取上面的 AppKey。
# 若推送报 400 resource.not.found「robot 不存在」，说明机器人是在钉钉后台「机器人管理」
# 里单独创建的（robotCode 与 AppKey 不同），在这里填它自己的 robotCode。
# DINGTALK_ROBOT_CODE=

# Dashboard 跨网段访问令牌（默认放行本机 + 同网段；跨网段/公网必须配它）
# 注意：它同时决定服务是否绑定 0.0.0.0（对外暴露面），属启动期绑定，只能留在这里，改完需重启。
# DASHBOARD_TOKEN=
# DASHBOARD_ACCESS=localhost   # 收紧为仅本机

# 对外可达的服务基址：渠道消息里「📊 详情」链接的前缀（不带尾斜杠）。
# 不设置回落 http://<本机局域网IP>:<PORT>（同网段可直接点开）；跨网段/公网需填这里。
# PUBLIC_BASE_URL=https://agent.example.com

# 本机路径类覆盖（部署机器不同才需要）
# WORKING_DIR=/path/to/workspace                          # 未声明 workspace 的 agent 的默认工作目录
# RUNTIME_DIR=/path/to/user-dir                           # 用户目录（默认 ~/.foreman）
# CONFIG_DIR=/path/to/config                              # 内置配置目录（默认 <服务根>/server/config）
# KNOWLEDGE_DIR=/path/to/knowledge                        # 答疑知识库
# PLUGINS_DIR=/path/to/plugins                            # 业务 playbook plugin 根
# ASSISTANT_CODE_ROOTS=/path/to/repo-a,/path/to/repo-b    # 答疑可检索的业务仓库；勿填本服务目录
# MCP_CONFIG_FILE=server/config/mcp.servers.json

# 公共配置的临时覆盖（长期设置请改 server/config/app.json）
# PORT=3000
# MODEL=claude-sonnet-4-5
# ROUTER_MODEL=claude-haiku-4-5
# MAX_TURNS=50
# MAX_CONCURRENT_RUNS=8
# MEMORY=off
# DINGTALK_ACK=off
# DINGTALK_ACK_DELAY_MS=350
# RETRO_SCHEDULE=off
# RETRO_HOUR=21
# RETRO_NOTIFY_CHAT=            # 群 openConversationId，机器人主动推群
# RETRO_NOTIFY_USER=            # staffId（可逗号分隔），机器人单聊私发
# 复盘已归一为「内置定时任务」，上面两项决定它的结果投递到哪个会话；
# 想改时间/停用/看清单，直接跟 boss 说「有哪些定时任务」「取消定时任务 #id」。
